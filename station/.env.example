# station/.env — значения конкретной установки (вне git). Шаблон.
# Хосты и SSH — общие для station/run-tests.sh, station/tools/*.sh, station/loudness/run.py
STATION_SSH=user@station-host
GPU_SSH=user@gpu-host
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519

# Нормализатор громкости (station/loudness/run.py)
LOUDNESS_MEASURE_REMOTE=D:\data\loudness\measure.py
LOUDNESS_GPU_MUSIC_ROOT=D:\Music
LOUDNESS_GPU_CACHE=D:\data\loudness\loudness.json
LOUDNESS_APPLY_DIR=/srv/radio/loudness
LOUDNESS_STATION_CACHE=/mnt/data/loudness/loudness.json
LOUDNESS_LIBRARY_DB=/srv/radio/subwave/state/library.db

# Бэкап данных станции (station/tools/backup.sh --remote) — пути, как их видит
# хост станции; каталог архивов — приватная часть шары, создаётся один раз руками
BACKUP_STACK_DIR=/srv/radio/subwave
BACKUP_DEST_DIR=/mnt/data/backup/radio
BACKUP_KEEP=14

# Мостик TTS и библиотека голосов Chatterbox (station/tts-bridge/prep_voice.py;
# мостик опрашивает и сторож эфира)
TTS_BRIDGE_URL=http://gpu-host:4124
CHATTERBOX_VOICES_URL=http://gpu-host:4123/voices

# Сторож эфира (station/tools/watch.py, задача планировщика раз в 5 минут).
# Адрес станции — как её видят слушатели. Команда оповещения получает текст на
# stdin; без неё сторож печатает в stdout и выходит с кодом 1 при сбое. Значение
# команды — в одинарных кавычках целиком: этот файл читают и bash-скрипты
WATCH_STATION_URL=https://station-domain
WATCH_NOTIFY_CMD='"C:\Program Files\Git\bin\bash.exe" C:\path\to\_boss\cron\telegram-send.sh'
# по умолчанию — %LOCALAPPDATA%\subwave-watch.json
#WATCH_STATE_FILE=
