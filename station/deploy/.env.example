# subwave — boot-конфиг. Реальный .env живёт ТОЛЬКО на хосте станции
# (<stack-dir>/.env — ссылка на /etc/subwave/subwave.env, chmod 600) и в репозиторий
# не коммитится.
# Всё остальное (LLM, TTS, персона) собирает мастер на /onboarding и пишет в
# state/settings.json — это источник правды во время работы. Navidrome — исключение,
# см. ниже: его учётка нужна комнате, а комната мастера не читает.

# Учётка админки и мастера первого запуска.
# Пароль — `python -c "import secrets; print(secrets.token_hex(16))"`, хранить в
# менеджере секретов, не в репозитории.
ADMIN_USER=admin
ADMIN_PASS=

# Публичный адрес станции: absolute URL, OG-теги, manifest
SITE_URL=http://station-host:7700

# Адрес станции в подписи Web Push комнаты (https://<домен> или mailto:) — обязателен
PUSH_SUBJECT=https://fm.example.org

TZ=Europe/Moscow

# Navidrome — одна читающая учётка (isAdmin=false) на комнату и контроллер: subwave
# нужен только доступ к библиотеке, рескан запускает `music navidrome-scan` под своей
# админской учёткой. Адрес — LAN-адрес хоста Navidrome (debian, не хост станции), не
# 127.0.0.1 (изнутри контейнера он указывает в сам контейнер).
# Комната получает их через docker-compose.override.yml: без них сверка заказа
# отвечает 502, а скачивание — «Navidrome не настроен». Контроллер — через
# `env_file`, и тогда они перекрывают то, что записал мастер (state/setup-config.json):
# учётка Navidrome правится здесь, а не в мастере или админке. Читает их и onboard.py.
NAVIDROME_URL=http://debian-host:4533
NAVIDROME_USER=subwave
NAVIDROME_PASS=

# Голос Piper из каталога piper-voices (override монтирует его в /opt/piper/voices).
# Без этих строк контроллер берёт английский en_GB-alan — русский текст английским
# голосом. Пол — как у персоны ведущей: station/tts-bridge/README.md, «Запасной движок
# обязан быть того же пола».
PIPER_VOICE=/opt/piper/voices/ru_RU-irina-medium.onnx
PIPER_VOICE_CONFIG=/opt/piper/voices/ru_RU-irina-medium.onnx.json

# Пин версии образов; пусто — :latest. Заполнять: пустое значение означает, что
# ближайший `docker compose pull` меняет стек, а вернуться к прежнему состоянию
# после отказа будет не к чему. Текущий тег — на живой машине:
#   docker inspect --format '{{.Config.Image}}' sub-wave-controller
# SUBWAVE_VERSION=

# Порты — только для варианта docker-compose.byo.yml (у нас не используется,
# см. README: взят вариант со встроенным Caddy)
# WEB_PORT=7700
# CONTROLLER_PORT=7701
# ICECAST_PORT=7702

# --- переменные onboard.py (стек их не читает, нужны только скрипту; NAVIDROME_* — выше) ---
# SUBWAVE_URL=http://station-host:7700
# SUBWAVE_ADMIN_USER=admin
# SUBWAVE_ADMIN_PASS=
# LLM — OpenAI-совместимый шлюз (у нас — роль dj на LiteLLM)
# LLM_BASE_URL=http://station-host:4000/v1
# LLM_MODEL=dj
# LLM_API_KEY=   (ключ шлюза)
# снимок настроек станции (TTS, персона, шоу), снятый `onboard.py --export`
# SUBWAVE_SETTINGS_FILE=
